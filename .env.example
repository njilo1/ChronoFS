# ╔════════════════════════════════════════════════════════════╗
# ║ FSChrono — Variables d'environnement                       ║
# ║ Copier ce fichier en .env et remplir les valeurs réelles. ║
# ║ Ne JAMAIS commiter .env (déjà dans .gitignore).            ║
# ╚════════════════════════════════════════════════════════════╝

# ── Django ────────────────────────────────────────────────────
# Clé secrète Django — générer avec :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=changez-moi-en-production-avec-une-vraie-cle

# Mode debug (True en dev, False en production)
DJANGO_DEBUG=True

# Hôtes autorisés (séparés par des virgules)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=chronofs_db
POSTGRES_USER=chronofs_admin
POSTGRES_PASSWORD=changez-moi
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── CORS (frontend autorisé à appeler l'API) ──────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── JWT (durées de vie) ───────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Celery + Redis (optionnel — solver asynchrone) ────────────
# Activer uniquement si le solver dépasse 30s en synchrone
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
USE_CELERY=False

# ── Frontend (Vite) ───────────────────────────────────────────
# Préfixer obligatoirement par VITE_ pour exposition côté client
VITE_API_BASE_URL=http://localhost:8000/api
VITE_APP_NAME=FSChrono
